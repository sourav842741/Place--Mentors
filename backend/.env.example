CLIENT_URL=http://localhost:5173
PORT=5000

MONGOURL="mongodb+srv://<db_username>:<db_password>@<cluster>.mongodb.net/<db_name>"
JWT_SECRET="<your_jwt_secret>"
CLOUDINARY_CLOUD_NAME="<your_cloudinary_cloud_name>"
CLOUDINARY_API_KEY="<your_cloudinary_api_key>"
CLOUDINARY_API_SECRET="<your_cloudinary_api_secret>"
EMAIL="<your_smtp_email>"
EMAIL_PASS="<your_smtp_app_password>"

OPENROUTER_API_KEY=<your_openrouter_api_key>
RAZORPAY_KEY_ID=<your_razorpay_key_id>
RAZORPAY_KEY_SECRET=<your_razorpay_key_secret>

YOUTUBE_API_KEY=<your_youtube_api_key>

GOOGLE_CLIENT_ID=<your_google_client_id>
GOOGLE_CLIENT_SECRET=<your_google_client_secret>
GOOGLE_REDIRECT_URI=http://localhost:5000/oauth2callback

ADZUNA_APP_ID=<your_adzuna_app_id>
ADZUNA_APP_KEY=<your_adzuna_app_key>

GEMINI_API_KEY=<your_gemini_api_key>

NEWS_API_KEY=<your_news_api_key>

ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=<change_me>

RESEND_API_KEY=<your_resend_api_key>
EMAIL_FROM=Place Mentors <noreply@example.com>

EMAIL_AUTH=Security <security@example.com>

PRODUCTION_CLIENT_URL=https://your-production-domain.com

TWILIO_ACCOUNT_SID=<your_twilio_account_sid>
TWILIO_AUTH_TOKEN=<your_twilio_auth_token>
TWILIO_PHONE_NUMBER=+1XXXXXXXXXX

VIDEOSDK_API_KEY=<your_videosdk_api_key>
VIDEOSDK_SECRET_KEY=<your_videosdk_secret_key>
VIDEOSDK_AGENT_ID=<your_videosdk_agent_id>
GATEWAY_ID=<your_gateway_id>

BASE_URL=http://localhost:5000

SUPER_ADMIN_EMAIL=owner@example.com
SUPER_ADMIN_PASSWORD=<change_me>

ALLOW_SEED=true
SEED_SECRET=<your_seed_secret>


REDIS_ENABLED=true
REDIS_HOST=<your_redis_host>
REDIS_PORT=6379
REDIS_PASSWORD=<your_redis_password>
REDIS_DB=0
REDIS_TLS=false
REDIS_KEY_PREFIX=placementor:


RABBITMQ_URL=amqps://<username>:<password>@<host>/<vhost>



PAYMENTS_PG_ENABLED=true

PGHOST=<your_postgres_host>
PGPORT=5432
PGDATABASE=<your_postgres_database>
PGUSER=<your_postgres_user>
PGPASSWORD=<your_postgres_password>

PGSSL_ENABLED=true

SENTRY_DSN=<your_sentry_dsn>

NODE_ENV=development
